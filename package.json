{
	"name": "@carrismetropolitana/accounts",
	"version": "1.0.0",
	"keywords": [],
	"main": "index.js",
	"scripts": {
		"build": "turbo build",
		"build:organize-accounts": "turbo build --filter=@carrismetropolitana/accounts-organize-accounts",
		"build:organize-widgets": "turbo build --filter=@carrismetropolitana/accounts-organize-widgets",
		"build:packages": "turbo build --filter=@carrismetropolitana/accounts-pckg-*",
		"build:server": "turbo build --filter=@carrismetropolitana/accounts-server",
		"dev": "dotenv-run -f ./environments/development/secrets/.env -- turbo dev",
		"dev:organize-accounts": "dotenv-run -f ./environments/development/secrets/.env -- turbo dev --filter=@carrismetropolitana/accounts-organize-accounts",
		"dev:organize-widgets": "dotenv-run -f ./environments/development/secrets/.env -- turbo dev --filter=@carrismetropolitana/accounts-organize-widgets",
		"dev:server": "dotenv-run -f ./environments/development/secrets/.env -- turbo dev --filter=@carrismetropolitana/accounts-server",
		"lint": "turbo lint",
		"lint:fix": "turbo lint:fix",
		"rinse": "npx --yes @tmlmobilidade/repo-rinse"
	},
	"devDependencies": {
		"@carrismetropolitana/eslint": "20250622.1204.50",
		"@dotenv-run/cli": "1.3.6",
		"turbo": "2.5.8",
		"typescript": "5.9.3"
	},
	"packageManager": "npm@11.6.1",
	"workspaces": [
		"apps/*",
		"helpers/*",
		"packages/*"
	]
}
